@model IEnumerable<Equipment>

@{
    ViewData["Title"] = "Оборудование";
}

<h1>Оборудование</h1>

<p>
    @if (User.IsInRole("Admin")) { <a asp-action="Create" class="btn btn-success">Добавить оборудование</a> }
</p>

<form method="get" class="row g-2 mb-3">
<div class="col-md-4"><label for="productionSiteId" class="form-label">Участок</label><select id="productionSiteId" name="productionSiteId" asp-items="ViewBag.ProductionSiteId" class="form-select"><option value="">Все участки</option></select></div>
<div class="col-md-4"><label for="field" class="form-label">Искать по</label><select id="field" name="field" asp-items="ViewBag.Fields" class="form-select"></select></div>
<div class="col-md-4"><label for="match" class="form-label">Условие</label><select id="match" name="match" asp-items="ViewBag.Matches" class="form-select"></select></div>
<div class="col-md-4"><label for="search" class="form-label">Текст</label><input id="search" name="search" value="@ViewData["Search"]" maxlength="100" class="form-control" /></div>
<div class="col-md-4"><label for="sortBy" class="form-label">Сортировать по</label><select id="sortBy" name="sortBy" asp-items="ViewBag.Sorts" class="form-select"></select></div>
<div class="col-md-4"><label for="direction" class="form-label">Порядок</label><select id="direction" name="direction" asp-items="ViewBag.Directions" class="form-select"></select></div>
<div class="col-12"><button class="btn btn-primary">Применить</button> <a asp-action="Index">Сбросить</a></div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">Оборудование не найдено.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                <th>@Html.DisplayNameFor(model => model.Model)</th>
                <th>@Html.DisplayNameFor(model => model.InventoryNumber)</th>
                <th>@Html.DisplayNameFor(model => model.ProductionSiteName)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Model</td>
                    <td>@item.InventoryNumber</td>
                    <td>@item.ProductionSiteName</td>
                    <td>
                        @if (User.IsInRole("Admin")) { <a asp-action="Edit" asp-route-id="@item.Id">Изменить</a> } |
                        <a asp-action="Details" asp-route-id="@item.Id">Подробнее</a> |
                        @if (User.IsInRole("Admin")) { <a asp-action="Delete" asp-route-id="@item.Id">Удалить</a> }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
